---
import CrtMonitor from "./CrtMonitor.astro";
---

<main class="editorial-shell">
  <header class="editorial-bar">
    <span>JUAN ARAUJO</span><span>ENGINEERING × PRODUCT</span><span
      >2020 — PRESENT</span
    >
  </header>
  <section class="editorial-main" aria-labelledby="hero-title">
    <p class="editorial-kicker">
      Software Engineer<br />with a product mindset.
    </p>
    <h1 id="hero-title">The web should<br /><em>feel good.</em></h1>
    <div class="editorial-bottom">
      <p>And that's why I'm here.</p>
      <nav class="editorial-actions" aria-label="Portfolio links">
        <a href="#story">Read the story <span>↗</span></a><a
          href="https://linkedin.com/in/baltaza"
          target="_blank"
          rel="noopener">LinkedIn <span>↗</span></a
        ><a
          href="https://drive.google.com/file/d/1_VD7rlEnLHo750ggmAMi31mfKWgwJpu1/view?usp=sharing"
          target="_blank"
          rel="noopener">CV <span>↓</span></a
        >
      </nav>
    </div>
    <CrtMonitor />
  </section>
  <div class="editorial-mark" aria-hidden="true">
    01<br /><small>SELECTED<br />WORK</small>
  </div>
</main>
<section class="story" id="story" aria-labelledby="story-title">
  <div class="story-meta">02 / A SHORT NOTE</div><article>
    <p class="story-kicker">Why I work</p><h2 id="story-title">
      Good software<br /><em>changes your life.</em>
    </h2><p>
    Since I was a kid, I've been tinkering with tech; I've grown fixated on tech products and how they can change your life. This could've been a Nintendo product, a new website, a new game, or something shiny that could change my day-to-day use, like a new Android ROM. I wanted to make something out of that. I figured that I could live my life not only experiencing how tech could potentially change my day-to-day, but how I could change the lives of many other people and share some of that joy.</p><p>
    So I'm here; I'm Juan, nice to meet you. A software engineer with an obsession and immense passion for the field. I care if something has my name or my team name on it. I take pride in what I do; for you as a potential employer, that translates to agency and creativity with a lot of ownership. Somebody to lift you. That only if you can pick my interest.</p><p>
    I'm currently tinkering full-time, meaning I'm unemployed. So, I'm looking for an awesome team that values craft, ownership, and that enjoys building product. Just as much as I do.   </p><p class="story-signoff">Juan Araujo</p>
  </article>
</section>
<style>
  .editorial-shell {
    min-height: 100svh;
    padding: 26px 4vw;
    color: var(--ink);
    background: var(--paper);
    position: relative;
  }
  .editorial-bar {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 15px;
    font: 11px var(--mono);
    letter-spacing: 0.06em;
  }
  .editorial-main {
    min-height: calc(100svh - 100px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 1000px;
    position: relative;
    z-index: 2;
  }
  .editorial-kicker,
  .editorial-shell h1,
  .editorial-bottom {
    position: relative;
    z-index: 2;
  }
  .editorial-kicker {
    font: 14px/1.35 var(--mono);
    margin: 0 0 34px;
  }
  .editorial-shell h1 {
    font: clamp(4rem, 10vw, 10.5rem) / 0.82 var(--serif);
    letter-spacing: -0.07em;
    font-weight: 400;
    margin: 0;
  }
  .editorial-shell h1 em,
  .story h2 em {
    font-style: italic;
  }
  .editorial-bottom {
    display: flex;
    gap: 10vw;
    margin-top: 55px;
    max-width: 680px;
    font: 16px/1.5 var(--serif);
  }
  .editorial-bottom p {
    margin: 0;
    max-width: 390px;
  }
  .editorial-actions {
    align-self: flex-end;
    display: flex;
    gap: 18px;
    font: 12px var(--mono);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .editorial-actions a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid;
    padding-bottom: 4px;
  }
  .editorial-actions a:first-child {
    border-color: var(--accent-ink);
  }
  .editorial-actions span {
    color: var(--accent-ink);
  }
  .editorial-mark {
    position: absolute;
    right: 4vw;
    bottom: 40px;
    font: 11px var(--mono);
    text-align: right;
  }
  .editorial-mark small {
    font-size: 9px;
    line-height: 1.3;
    display: block;
    color: #777;
  }
  .story {
    background: #f5f1e9;
    color: #211e1a;
    padding: 14vh 7vw 18vh;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 6vw;
  }
  .story-meta,
  .story-kicker {
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .story article {
    max-width: 680px;
  }
  .story h2 {
    font: clamp(2.8rem, 6vw, 6rem) / 0.9 var(--serif);
    letter-spacing: -0.06em;
    font-weight: 400;
    margin: 0 0 32px;
  }
  .story article p:not(.story-kicker):not(.story-signoff) {
    font: 17px/1.65 var(--serif);
    margin: 0 0 22px;
  }
  .story-signoff {
    font-style: italic;
    margin-top: 42px;
    font: 20px/1.4 var(--serif);
  }

  /* Entrance — the shared 420ms cubic-bezier(.23,1,.32,1) token from the prototype. */
  .editorial-kicker {
    animation: enter var(--enter-duration) var(--enter-easing) both;
  }
  .editorial-shell h1 {
    animation: enter var(--enter-duration) var(--enter-easing) 50ms both;
  }
  .editorial-bottom {
    animation: enter var(--enter-duration) var(--enter-easing) 100ms both;
  }

  /* Scroll reveal — JS opts .story into .reveal only when it can animate it back. */
  .story.reveal {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity var(--enter-duration) var(--enter-easing),
      transform var(--enter-duration) var(--enter-easing);
  }
  .story.reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .editorial-actions a {
      transition: color 160ms ease-out, border-color 160ms ease-out;
    }
    .editorial-actions a:hover {
      color: var(--accent-ink);
    }
    .editorial-actions a:active {
      transform: scale(0.97);
    }
  }

  @media (max-width: 700px) {
    .editorial-bar span:nth-child(2),
    .editorial-bar span:nth-child(3) {
      display: none;
    }
    .editorial-bottom {
      display: block;
      margin-top: 35px;
    }
    .editorial-main {
      min-height: calc(100svh - 100px);
    }
    .editorial-actions {
      align-self: auto;
      margin-top: 24px;
      flex-wrap: wrap;
      white-space: normal;
    }
    .editorial-shell h1 {
      font-size: clamp(3.5rem, 16vw, 7rem);
    }
    .story {
      display: block;
      padding: 12vh 7vw;
    }
    .story-meta {
      margin-bottom: 16vh;
    }
    .story h2 {
      font-size: clamp(2.8rem, 14vw, 5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-actions a {
      transition: none;
    }
    .editorial-kicker,
    .editorial-shell h1,
    .editorial-bottom {
      animation: none;
    }
    .story.reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const story = document.querySelector(".story");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (story && "IntersectionObserver" in window && !reduced) {
    story.classList.add("reveal");
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            story.classList.add("is-visible");
            io.disconnect();
          }
        }),
      { rootMargin: "0px 0px -12% 0px" }
    );
    io.observe(story);
  }
</script>
