---
import CrtArtifacts from "./CrtArtifacts.astro";
import CrtWebGL from "./CrtWebGL.astro";
import LegacyPage from "./LegacyPage.astro";
---

<aside
  class="crt-wrap"
  data-crt-wrap
  aria-label="A 2005 version of this portfolio rendered on a monitor"
>
  <CrtWebGL>
    <LegacyPage slot="screen" />
    <CrtArtifacts slot="artifacts" />
  </CrtWebGL>
  <p class="crt-caption"><span>MONITOR_01</span> / SIGNAL FOUND</p>
  <p class="crt-hint" aria-hidden="true">
    <span>Drag to orbit</span>
  </p>
</aside>

<style>
  .crt-wrap {
    position: absolute;
    z-index: 1;
    top: 50%;
    /* Right edge sits 3vw in from the page edge. 100cqw is the Hero shell's
       content box (see .editorial-shell), which, unlike 100vw, excludes the
       scrollbar; + 8vw adds back the shell's side padding. */
    right: calc(100% - 100vw + 7vw);
    right: calc(100% - 100cqw - 8vw + 7vw);
    width: min(43vw, 660px);
    box-sizing: border-box;
    overflow: visible;
    transform: translateY(-46%);
    pointer-events: auto;
  }

  .crt-wrap > :global(.crt-webgl) {
    width: 100%;
    min-width: 0;
    max-width: none;
    aspect-ratio: 1.08;
    overflow: visible;
    contain: layout;
  }

  .crt-caption {
    position: absolute;
    z-index: 3;
    right: 4%;
    /* tucked just under the foot — the canvas keeps orbit headroom below it */
    bottom: 9%;
    margin: 0;
    color: var(--ink-soft);
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .crt-caption span {
    color: var(--accent-ink);
  }

  .crt-hint {
    position: absolute;
    z-index: 3;
    left: 4%;
    bottom: 9%;
    margin: 0;
    color: var(--ink-soft);
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .crt-wrap:hover .crt-hint {
      opacity: 1;
    }
  }

  /* Stacked — phones and portrait tablets: the Monitor joins the flow between
     the headline and the links instead of sitting behind the type. */
  @media (max-width: 700px), (max-width: 1100px) and (orientation: portrait) {
    .crt-wrap {
      position: relative;
      order: 1;
      top: auto;
      right: auto;
      align-self: center;
      width: min(100%, 520px);
      margin: 3vh 0 0;
      transform: none;
    }

    .crt-wrap > :global(.crt-webgl) {
      aspect-ratio: 1.18;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crt-hint {
      transition: none;
    }
  }
</style>
