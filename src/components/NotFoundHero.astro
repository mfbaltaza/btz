---
const headerImgUrl = "https://i.imgur.com/qIufhof.png";
---

<main
  class="grid lg:grid-cols-2 place-items-center"
>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-extrabold lg:tracking-tight xl:tracking-tighter"
    >
      Just figuring stuff out
    </h1>
  </div>
  <div class="py-6 md:order-1 hidden md:block">
    <img alt="Safety Cones" src={headerImgUrl} />
  </div>
</main>

<style>
  h1 {
    animation: enter 420ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    h1 {
      animation: none;
    }
  }
</style>
