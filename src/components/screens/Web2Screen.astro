---
import XpBrowser from "./XpBrowser.astro";
import { workEntries } from "../../data/work";
const picks = workEntries.filter((w) => w.outcomes?.length).slice(0, 3);
---

<XpBrowser>
  <div class="w2">
    <header class="w2-head">
      <div class="w2-logo">juan<span>araujo</span><sup>beta</sup></div>
      <nav>
        <a class="on" href="#top">Home</a><a href="#work">Work</a><a href="#story">About</a><a href="mailto:hello@juan-araujo.com">Contact</a>
      </nav>
    </header>
    <section class="w2-hero">
      <div>
        <h1>I build web products<br />people <em>enjoy</em> using.</h1>
        <p>Software engineer, frontend &amp; product. Payments, dashboards, fast CMS sites.</p>
        <div class="w2-ctas">
          <a class="w2-btn" href="mailto:hello@juan-araujo.com">Hire Juan »</a>
          <a class="w2-link" href="https://drive.google.com/file/d/1_VD7rlEnLHo750ggmAMi31mfKWgwJpu1/view?usp=sharing">Download CV (PDF)</a>
        </div>
      </div>
      <div class="w2-badge"><b>Open</b><span>to the right team</span></div>
    </section>
    <section class="w2-cards" id="work">
      {picks.map((w) => (
        <article>
          <b class="num">{w.outcomes![0].value}</b>
          <span class="lbl">{w.outcomes![0].label}</span>
          <span class="co">{w.name} · {w.years}</span>
        </article>
      ))}
    </section>
  </div>
</XpBrowser>

<style>
  .w2 { display: flex; flex-direction: column; color: #333; background: #fff; font: 17px/1.4 "Trebuchet MS", Verdana, sans-serif; }
  .w2-head {
    display: flex; align-items: flex-end; justify-content: space-between; padding: 16px 34px 0;
    background: linear-gradient(#f7fbff, #dcebfa); border-bottom: 4px solid #6aa7e0;
  }
  .w2-logo { padding-bottom: 12px; font: bold 34px/1 "Trebuchet MS", sans-serif; color: #0063dc; letter-spacing: -1px; }
  .w2-logo span { color: #ff0084; }
  .w2-logo sup { margin-left: 6px; padding: 2px 6px; border-radius: 4px; font-size: 12px; letter-spacing: 0; color: #fff; background: #ff7b00; vertical-align: 14px; }
  .w2-head nav { display: flex; gap: 4px; }
  .w2-head a {
    padding: 9px 18px; border-radius: 9px 9px 0 0; color: #1a5aa6; text-decoration: none; font-weight: bold;
    background: linear-gradient(#ffffff, #cfe2f6);
  }
  .w2-head a.on { color: #fff; background: linear-gradient(#8cc0f2, #3d87d6 50%, #2c78cb 51%, #5aa0e6); }
  .w2-hero { display: flex; align-items: center; gap: 28px; padding: 26px 34px 18px; }
  h1 { margin: 0 0 10px; font: bold 40px/1.08 "Trebuchet MS", sans-serif; letter-spacing: -1.5px; color: #222; }
  h1 em { font-style: normal; color: #ff0084; }
  .w2-hero p { margin: 0 0 18px; max-width: 520px; color: #555; }
  .w2-ctas { display: flex; align-items: center; gap: 20px; }
  .w2-btn {
    padding: 11px 26px; border-radius: 22px; color: #fff; font-weight: bold; text-decoration: none;
    background: linear-gradient(#9fe36b, #5cb82e 50%, #4aa61f 51%, #79cc45); border: 1px solid #3b8c17;
    box-shadow: inset 0 1px rgba(255,255,255,.7), 0 2px 4px rgba(0,0,0,.2); text-shadow: 0 -1px #3b8c17;
  }
  .w2-link { color: #0063dc; }
  .w2-badge {
    flex: none; display: grid; place-items: center; align-content: center; width: 150px; height: 150px;
    border-radius: 50%; color: #fff; text-align: center; transform: rotate(8deg);
    background: radial-gradient(circle at 35% 30%, #ffb347, #ff7b00 60%, #e05f00);
    box-shadow: 0 4px 10px rgba(0,0,0,.25);
  }
  .w2-badge b { font-size: 32px; line-height: 1; }
  .w2-badge span { width: 110px; font-size: 14px; }
  .w2-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 4px 34px 22px; }
  .w2-cards article {
    display: grid; gap: 2px; padding: 14px 16px; border: 1px solid #c9dcf0; border-radius: 10px;
    background: linear-gradient(#ffffff, #eef5fc);
  }
  .num { font-size: 36px; line-height: 1; color: #0063dc; }
  .lbl { color: #333; }
  .co { font-size: 14px; color: #888; }
</style>
