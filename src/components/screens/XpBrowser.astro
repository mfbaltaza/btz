---
const { title = "Juan Araujo", url = "http://www.juanaraujo.com/" } = Astro.props;
---

<div class="xp">
  <div class="xp-title">
    <span class="xp-ie">e</span>
    <span class="xp-title-text">{title} - Microsoft Internet Explorer</span>
    <span class="xp-btns" aria-hidden="true"><i>_</i><i>□</i><i class="x">×</i></span>
  </div>
  <div class="xp-bar">
    <span class="xp-nav">◀ Back</span><span class="xp-nav dim">▶</span>
    <span class="xp-addr-l">Address</span>
    <span class="xp-addr"><b>e</b> {url}</span>
    <span class="xp-go">➜ Go</span>
  </div>
  <div class="xp-page"><slot /></div>
  <div class="xp-status"><span>Done</span><span class="zone">🌐 Internet</span></div>
</div>

<style>
  .xp {
    box-sizing: border-box; display: flex; flex-direction: column;
    background: #ece9d8; font: 15px/1.2 Tahoma, "Segoe UI", Verdana, sans-serif; text-align: left;
  }
  .xp-title {
    display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 6px 0 10px;
    color: #fff; font-weight: bold; font-size: 16px; text-shadow: 1px 1px #0a246a;
    background: linear-gradient(#0a5fd8 0%, #3d95ff 9%, #0058e6 18%, #0050d8 70%, #0045b8 100%);
    border-radius: 8px 8px 0 0;
  }
  .xp-ie {
    display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%;
    color: #1d6fd8; background: #fff; font: bold 16px/1 Georgia, serif; text-shadow: none;
  }
  .xp-title-text { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .xp-btns { display: flex; gap: 3px; }
  .xp-btns i {
    display: grid; place-items: center; width: 24px; height: 24px; border: 1px solid #fff; border-radius: 4px;
    font-style: normal; font-size: 14px; background: linear-gradient(#5d9cfb, #2763dd);
  }
  .xp-btns .x { background: linear-gradient(#e8835f, #c73b1a); }
  .xp-bar {
    display: flex; align-items: center; gap: 10px; height: 38px; padding: 0 10px;
    border-bottom: 1px solid #aca899; color: #000;
  }
  .xp-nav { padding: 4px 8px; border-radius: 3px; }
  .xp-nav.dim { color: #9a9a9a; }
  .xp-addr-l { color: #555; }
  .xp-addr {
    flex: 1; padding: 4px 8px; border: 1px solid #7f9db9; background: #fff;
    white-space: nowrap; overflow: hidden;
  }
  .xp-addr b { color: #1d6fd8; font-family: Georgia, serif; }
  .xp-go { color: #1e7d1e; }
  .xp-page { flex: 1; min-height: 0; overflow: hidden; background: #fff; }
  .xp-page > :global(*) { height: 100%; }
  .xp-status {
    display: flex; justify-content: space-between; height: 26px; padding: 0 10px; align-items: center;
    border-top: 1px solid #aca899; color: #333; font-size: 13px;
  }
  .zone { padding-left: 12px; border-left: 1px solid #aca899; }
</style>
