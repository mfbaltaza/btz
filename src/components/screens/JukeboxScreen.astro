---
import { workEntries } from "../../data/work";
---

<div class="juke">
  <header class="top">
    <div class="ctrls"><span>◀◀</span><span class="play">▶</span><span>▶▶</span></div>
    <div class="lcd">
      <small>Now playing</small>
      <b>Juan Araujo — “The web should feel good”</b>
      <small>Software engineer · frontend &amp; product · open to the right team</small>
      <div class="bar"><i></i></div>
    </div>
    <a class="pill" href="mailto:hello@juan-araujo.com">✉ Say hi</a>
  </header>
  <div class="cols">
    <aside class="side">
      <p class="hd">LIBRARY</p>
      <a class="on" href="#work">♫ Work</a>
      <a href="#story">✎ Story</a>
      <p class="hd">LINKS</p>
      <a href="https://linkedin.com/in/baltaza" target="_blank" rel="noopener">in LinkedIn</a>
      <a href="https://drive.google.com/file/d/1_VD7rlEnLHo750ggmAMi31mfKWgwJpu1/view?usp=sharing" target="_blank" rel="noopener">⇩ CV.pdf</a>
    </aside>
    <table>
      <thead><tr><th></th><th>Name</th><th>Role</th><th>Hit</th><th>Year</th></tr></thead>
      <tbody>
        {workEntries.map((w, i) => (
          <tr class={i === 0 ? "sel" : ""}>
            <td class="n">{i === 0 ? "🔊" : i + 1}</td>
            <td><b>{w.name}</b></td>
            <td>{w.role}</td>
            <td>{w.outcomes?.[0] ? `${w.outcomes[0].value} ${w.outcomes[0].label}` : "—"}</td>
            <td>{w.years}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <footer class="foot">{workEntries.length} projects, 5 years, 0 skipped</footer>
</div>

<style>
  .juke {
    box-sizing: border-box; display: flex; flex-direction: column;
    color: #1d1d1f; background: #d9dde3;
    font: 16px/1.3 "Lucida Grande", "Helvetica Neue", Arial, sans-serif; text-align: left;
  }
  .top {
    display: flex; align-items: center; gap: 22px; padding: 14px 20px;
    background: linear-gradient(#f4f5f7, #c3c8cf); border-bottom: 1px solid #8a9099;
  }
  .ctrls { display: flex; gap: 8px; }
  .ctrls span {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    font-size: 14px; color: #333; background: linear-gradient(#fff, #c9ced6);
    border: 1px solid #7d848e; box-shadow: inset 0 1px #fff;
  }
  .ctrls .play { width: 56px; height: 56px; font-size: 22px; }
  .lcd {
    flex: 1; display: grid; justify-items: center; gap: 3px; padding: 8px 16px;
    border-radius: 8px; border: 1px solid #8f9a80;
    background: linear-gradient(#f3f6e4, #dfe6c7); box-shadow: inset 0 1px 3px rgba(0,0,0,.25);
  }
  .lcd b { font-size: 21px; }
  .lcd small { font-size: 13px; color: #556; }
  .bar { width: 80%; height: 7px; border-radius: 4px; background: #c4cab0; border: 1px solid #8f9a80; }
  .bar i { display: block; width: 62%; height: 100%; border-radius: 4px; background: #5a6550; }
  .pill {
    padding: 10px 20px; border-radius: 20px; color: #fff; text-decoration: none; font-weight: bold;
    background: linear-gradient(#7fb8ff, #2a6fdb 50%, #1d5bc4 51%, #4f93f0); border: 1px solid #1a4fa8;
    box-shadow: inset 0 1px rgba(255,255,255,.6);
  }
  .cols { flex: 1; display: flex; min-height: 0; }
  .side { width: 190px; padding: 10px 0; background: #dfe5ed; border-right: 1px solid #9aa3ad; }
  .hd { margin: 10px 16px 4px; font-size: 12px; font-weight: bold; color: #6b7480; }
  .side a { display: block; padding: 6px 20px; color: #1d1d1f; text-decoration: none; }
  .side a.on { color: #fff; background: linear-gradient(#6aa0e8, #3a73c9); }
  table { flex: 1; border-spacing: 0; background: #fff; align-self: flex-start; }
  th { padding: 6px 10px; font-size: 13px; font-weight: normal; text-align: left; color: #333;
       background: linear-gradient(#fafafa, #dcdcdc); border-bottom: 1px solid #999; border-right: 1px solid #ccc; }
  td { padding: 9px 10px; }
  tbody tr:nth-child(even) { background: #edf3fe; }
  tr.sel { color: #fff; background: #3875d7 !important; }
  .n { width: 26px; color: #888; text-align: right; }
  tr.sel .n { color: #fff; }
  .foot { padding: 7px; font-size: 13px; text-align: center; color: #444; background: linear-gradient(#e6e8eb, #c4c9d0); border-top: 1px solid #8a9099; }
</style>
