---
import { workEntries } from "../../data/work";
const clients = workEntries.filter((w) => w.kind === "client");
const icons = [
  { label: "Work", glyph: "📁", href: "#work" },
  { label: "Story.txt", glyph: "📄", href: "#story" },
  { label: "CV.pdf", glyph: "📕", href: "https://drive.google.com/file/d/1_VD7rlEnLHo750ggmAMi31mfKWgwJpu1/view?usp=sharing" },
  { label: "LinkedIn", glyph: "🌐", href: "https://linkedin.com/in/baltaza" },
  { label: "Mail Juan", glyph: "✉️", href: "mailto:hello@juan-araujo.com" },
];
---

<div class="desk">
  <div class="menubar">
    <b></b><span><b>Finder</b></span><span>File</span><span>Edit</span><span>View</span><span>Special</span>
    <span class="clock">Sat 10:05 PM</span>
  </div>
  <div class="icons">
    {icons.map((i) => (
      <a class="icon" href={i.href}><span class="glyph">{i.glyph}</span><span class="lbl">{i.label}</span></a>
    ))}
    <div class="icon trash"><span class="glyph">🗑️</span><span class="lbl">Trash</span></div>
  </div>
  <section class="win">
    <header class="title"><i></i><span>About Juan</span><i></i></header>
    <div class="body">
      <img src="/juan.jpg" alt="" />
      <div>
        <h1>Juan Araujo</h1>
        <p class="sub">Software engineer · frontend &amp; product</p>
        <p>I build web products that feel good to use: payment flows, analytics dashboards and fast headless-CMS sites.</p>
        <p class="status"><span>●</span> Open to the right team</p>
      </div>
    </div>
  </section>
  <section class="win win--work">
    <header class="title"><i></i><span>Work — {clients.length} items</span><i></i></header>
    <ul>
      {clients.map((w) => (<li><span>📁 {w.name}</span><span>{w.years}</span></li>))}
    </ul>
  </section>
</div>

<style>
  .desk {
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    color: #111;
    background: #6c7fa6 repeating-linear-gradient(45deg, rgba(255,255,255,.05) 0 2px, transparent 2px 6px);
    font: 17px/1.35 "Charcoal", "Chicago", "Lucida Grande", Geneva, Verdana, sans-serif;
    text-align: left;
  }
  .menubar {
    display: flex; gap: 22px; align-items: center;
    height: 34px; padding: 0 18px;
    background: linear-gradient(#fdfdfd, #dcdcdc); border-bottom: 1px solid #555;
  }
  .clock { margin-left: auto; }
  .icons {
    position: absolute; top: 56px; right: 26px;
    display: grid; gap: 14px; justify-items: center;
  }
  .icon { display: grid; justify-items: center; width: 108px; color: #fff; text-decoration: none; }
  .glyph { font-size: 40px; line-height: 1.1; filter: drop-shadow(0 2px 0 rgba(0,0,0,.25)); }
  .lbl { padding: 0 4px; font-size: 15px; background: rgba(0,0,0,.35); }
  .icon:hover .lbl { background: #1d3d8f; }
  .trash { position: absolute; top: 420px; }
  .win {
    position: absolute; top: 66px; left: 42px; width: 560px;
    border: 1px solid #222; background: #eee;
    box-shadow: 2px 2px 0 rgba(0,0,0,.35), inset 1px 1px #fff;
  }
  .title {
    display: flex; align-items: center; gap: 10px; height: 26px; padding: 0 8px;
    background: repeating-linear-gradient(#e8e8e8 0 1px, #b9b9b9 1px 2px);
    font-weight: bold; font-size: 15px;
  }
  .title i { flex: 1; height: 0; }
  .title span { padding: 0 8px; background: #e2e2e2; }
  .body { display: flex; gap: 20px; padding: 20px; background: #fff; margin: 4px; border: 1px solid #999; }
  .body img { width: 120px; height: 120px; object-fit: cover; border: 1px solid #333; filter: grayscale(.2); }
  h1 { margin: 0; font: bold 34px/1.05 Georgia, serif; }
  .sub { margin: 4px 0 10px; color: #555; }
  .body p { margin: 0 0 8px; }
  .status span { color: #2a9a3a; }
  .win--work { top: 300px; left: 260px; width: 420px; }
  .win--work ul { margin: 4px; padding: 8px 14px; list-style: none; background: #fff; border: 1px solid #999; }
  .win--work li { display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px dotted #bbb; }
  .win--work li:last-child { border: 0; }
</style>
