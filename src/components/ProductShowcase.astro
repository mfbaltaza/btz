---
// Launched — the side products that are live, shown as two plates inside
// Selected Work. Each plate is a dark "product shot" drawn in markup (the
// products' own pages are near-black), paired with an editorial caption in
// the site's paper/ink voice. The whole card links out to the live page.
import { workEntries } from "../data/work";

const products = workEntries.filter((e) => e.kind === "product");
const host = (url: string) => new URL(url).host;
---

<div class="launch">
  <h3 class="launch-label">Launched</h3>
  <ul class="launch-grid">
    {
      products.map((p, i) => (
        <li>
          <a
            class="launch-card"
            href={p.url}
            target="_blank"
            rel="noopener"
            data-product={p.id}
          >
            <div class="plate" aria-hidden="true">
              {p.id === "allowme" ? (
                <div class="am">
                  <div class="am-key">
                    <span>hold</span>
                  </div>
                  <div class="am-wave">
                    {Array.from({ length: 22 }, (_, b) => (
                      <i
                        style={`--b:${b};--h:${(
                          0.3 +
                          0.7 * Math.abs(Math.sin(b * 1.7))
                        ).toFixed(2)}`}
                      />
                    ))}
                  </div>
                  <p class="am-text">
                    ship the landing pages tonight
                    <span class="am-caret" />
                  </p>
                  <p class="am-chip">on-device · no cloud</p>
                </div>
              ) : (
                <div class="lp">
                  <div class="lp-screen">
                    <span class="lp-rec">
                      <i />
                      REC 00:42
                    </span>
                    <div class="lp-win">
                      <span />
                      <span />
                      <span />
                    </div>
                  </div>
                  <div class="lp-trim">
                    <div class="lp-track">
                      <span class="lp-sel" />
                      <span class="lp-head" />
                    </div>
                  </div>
                  <p class="lp-link">
                    <span>↗ link copied</span>
                  </p>
                </div>
              )}
            </div>

            <div class="cap">
              <p class="cap-meta">
                <span>{String(i + 1).padStart(2, "0")}</span>
                <span>{p.years}</span>
                <span>{p.stack.join(" · ")}</span>
              </p>
              <p class="cap-name">{p.name}</p>
              <p class="cap-tag">
                <em>{p.tagline}</em>
              </p>
              <p class="cap-blurb">{p.blurb}</p>
              <p class="cap-visit">
                <span class="cap-url">{host(p.url!)}</span>
                <span class="cap-cta">
                  Visit <span aria-hidden="true">↗</span>
                </span>
                <span class="visually-hidden"> (opens in a new tab)</span>
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .launch {
    max-width: 1000px;
    margin: 9vh auto 0;
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    --plate: #0b0b0c;
    --plate-ink: #f2efe9;
    --plate-soft: #8b877f;
  }
  .launch-label {
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin: 0 0 28px;
    font-weight: 400;
  }
  .launch-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .launch-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .launch-card:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 6px;
  }

  /* ---- The plate: a product shot drawn in markup ---- */
  .plate {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: radial-gradient(
        120% 90% at 50% 0%,
        #1c1c1f 0%,
        var(--plate) 60%
      ),
      var(--plate);
    color: var(--plate-ink);
    font-family: var(--mono);
    transition: transform 320ms var(--ease);
  }
  /* Grain-free hairline frame, like a mounted print. */
  .plate::after {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    pointer-events: none;
  }

  /* allowme: key → waveform → typed text */
  .am {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto auto auto;
    align-content: center;
    justify-items: center;
    gap: 22px;
    padding: 8%;
  }
  .am-key {
    display: grid;
    place-items: center;
    width: 84px;
    height: 64px;
    border-radius: 10px;
    background: linear-gradient(#2a2a2e, #18181b);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 4px 0 #050506,
      0 10px 20px rgba(0, 0, 0, 0.5);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--plate-ink);
    animation: am-press 2.4s var(--ease) infinite;
  }
  .am-wave {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 40px;
  }
  .am-wave i {
    display: block;
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: var(--plate-ink);
    opacity: 0.85;
    transform: scaleY(var(--h));
    animation: am-wave 0.9s ease-in-out infinite alternate;
    animation-delay: calc(var(--b) * -170ms);
  }
  .am-text {
    margin: 0;
    font: italic clamp(15px, 1.8vw, 20px) / 1.3 var(--serif);
    text-align: center;
  }
  .am-caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 3px;
    vertical-align: -0.12em;
    background: #e5484d;
    animation: caret 1s steps(1) infinite;
  }
  .am-chip {
    position: absolute;
    left: 22px;
    bottom: 20px;
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--plate-soft);
  }

  /* Looped: recording window → trim bar → link */
  .lp {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: 14px;
    padding: 6% 17%;
  }
  .lp-screen {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    background: #17171a;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 0 3px rgba(229, 72, 77, 0.55);
    overflow: hidden;
  }
  .lp-rec {
    position: absolute;
    top: 9px;
    left: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--plate-ink);
  }
  .lp-rec i {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e5484d;
    animation: caret 1.4s steps(1) infinite;
  }
  .lp-win {
    position: absolute;
    left: 14%;
    right: 14%;
    top: 34%;
    bottom: 14%;
    display: grid;
    gap: 7px;
    align-content: start;
    padding: 10px;
    border-radius: 4px;
    background: #222226;
  }
  .lp-win span {
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.14);
  }
  .lp-win span:nth-child(2) {
    width: 72%;
  }
  .lp-win span:nth-child(3) {
    width: 48%;
  }
  .lp-track {
    position: relative;
    height: 22px;
    border-radius: 4px;
    background: repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.1) 0 2px,
        transparent 2px 9px
      ),
      #141416;
  }
  .lp-sel {
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: 18%;
    right: 26%;
    border: 2px solid #f2c94c;
    border-left-width: 6px;
    border-right-width: 6px;
    border-radius: 4px;
  }
  .lp-head {
    position: absolute;
    top: -5px;
    bottom: -5px;
    left: 18%;
    width: 2px;
    background: var(--plate-ink);
    animation: lp-play 3.2s linear infinite;
  }
  .lp-link {
    justify-self: start;
    margin: 0;
  }
  .lp-link span {
    display: inline-block;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--plate-ink);
    color: var(--plate);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  /* ---- Caption ---- */
  .cap {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 20px;
    font-family: var(--serif);
  }
  .cap-meta {
    display: flex;
    gap: 14px;
    margin: 0 0 14px;
    font: 11px var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .cap-name {
    margin: 0;
    font: clamp(2.2rem, 4.4vw, 3.6rem) / 0.95 var(--serif);
    letter-spacing: -0.04em;
  }
  .cap-tag {
    margin: 8px 0 14px;
    font: clamp(1.1rem, 1.6vw, 1.35rem) / 1.3 var(--serif);
  }
  .cap-blurb {
    margin: 0 0 22px;
    max-width: 440px;
    font: 14px/21px var(--serif);
    color: var(--ink-soft);
  }
  .cap-visit {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: auto 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font: 11px var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cap-url {
    color: var(--ink-soft);
    text-transform: none;
    letter-spacing: 0;
  }
  .cap-cta {
    color: var(--accent-ink);
  }
  .cap-cta span {
    display: inline-block;
    transition: transform 220ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .launch-card:hover .plate {
      transform: translateY(-6px);
    }
    .launch-card:hover .cap-cta span {
      transform: translate(3px, -3px);
    }
    .launch-card:hover .cap-name {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 6px;
    }
  }

  @keyframes am-wave {
    from {
      transform: scaleY(calc(var(--h) * 0.35));
    }
    to {
      transform: scaleY(var(--h));
    }
  }
  @keyframes am-press {
    0%,
    55%,
    100% {
      transform: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 4px 0 #050506,
        0 10px 20px rgba(0, 0, 0, 0.5);
    }
    8%,
    48% {
      transform: translateY(3px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 1px 0 #050506,
        0 4px 10px rgba(0, 0, 0, 0.5);
    }
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  @keyframes lp-play {
    to {
      left: 74%;
    }
  }

  @media (max-width: 700px) {
    .launch-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }
  /* Reduced motion: a still product shot. */
  @media (prefers-reduced-motion: reduce) {
    .plate,
    .cap-cta span {
      transition: none;
    }
    .am-key,
    .am-wave i,
    .am-caret,
    .lp-rec i,
    .lp-head {
      animation: none;
    }
  }
</style>
