---
// Selected Work — editorial index of case studies and hobby projects.
// Each row is a disclosure (APG accordion pattern): the description opens
// on click / tap / Enter / Space, never on hover, so pointing at a row
// can't push the rows beneath it around. Panels open independently, so
// opening one never moves anything above the row you acted on.
import { workEntries } from "../data/work";

const client = workEntries.filter((e) => e.kind === "client");
const hobby = workEntries.filter((e) => e.kind === "hobby");
---

<section class="work" aria-labelledby="work-title" data-work>
  <div class="work-head">
    <p class="work-kicker">03 / Selected Work</p>
    <h2 id="work-title">Work that shipped.</h2>
    <p class="work-dek">
      Case studies from teams I’ve worked with, and the things I build because I
      can’t not.
    </p>
  </div>

  {
    [
      { label: "Client Work — Case Studies", items: client },
      { label: "Hobby Projects", items: hobby },
    ].map((group) => (
      <div class="work-group">
        <h3 class="work-group-label">{group.label}</h3>
        <ol class="work-list">
          {group.items.map((entry, i) => (
            <li>
              <h4 class="row-heading">
                <button
                  type="button"
                  class="work-row"
                  aria-expanded="false"
                  aria-controls={`work-${entry.id}`}
                  id={`work-${entry.id}-label`}
                >
                  <span class="row-num" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="row-title">{entry.name}</span>
                  <span class="row-role">{entry.role}</span>
                  <span class="row-years">{entry.years}</span>
                  <span class="row-toggle" aria-hidden="true" />
                </button>
              </h4>
              <div
                class="row-panel"
                id={`work-${entry.id}`}
                role="region"
                aria-labelledby={`work-${entry.id}-label`}
              >
                <div class="row-panel-clip">
                  <p class="row-blurb">{entry.blurb}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</section>

<style>
  .work {
    background: var(--paper);
    color: var(--ink);
    padding: 14vh 4vw 12vh;
    font-family: var(--serif);
  }
  .work-head {
    max-width: 1000px;
    margin: 0 auto 9vh;
  }
  .work-kicker {
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin: 0 0 28px;
  }
  .work-head h2 {
    font: clamp(2.6rem, 5vw, 4.75rem) / 0.95 var(--serif);
    letter-spacing: -0.035em;
    font-weight: 400;
    margin: 0 0 26px;
  }
  .work-dek {
    font: 16px/1.55 var(--serif);
    color: var(--ink-soft);
    max-width: 420px;
    margin: 0;
  }

  .work-group {
    max-width: 1000px;
    margin: 0 auto;
  }
  .work-group + .work-group {
    margin-top: 9vh;
  }
  .work-group-label {
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin: 0 0 6px;
    font-weight: 400;
  }
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .work-list li + li {
    border-top: 1px solid var(--rule);
  }
  /* Row heading — resets so the h4 only carries semantics. */
  .row-heading {
    margin: 0;
    font: inherit;
  }
  .work-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto auto 2rem;
    gap: 18px;
    align-items: baseline;
    width: 100%;
    padding: 26px 8px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .work-row:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }
  .row-num {
    font: 11px var(--mono);
    color: var(--ink-soft);
  }
  .row-title {
    font: clamp(1.7rem, 3.4vw, 2.9rem) / 1 var(--serif);
    letter-spacing: -0.03em;
  }
  .row-role,
  .row-years {
    font: 11px var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* Plus that folds into a minus — tells you the row opens, and which
     ones are open, without relying on hover. */
  .row-toggle {
    justify-self: end;
    align-self: center;
    position: relative;
    width: 12px;
    height: 12px;
    color: var(--accent-ink);
  }
  .row-toggle::before,
  .row-toggle::after {
    content: "";
    position: absolute;
    inset: 5px 0;
    background: currentColor;
    transition: transform 260ms var(--enter-easing);
  }
  .row-toggle::after {
    transform: rotate(90deg);
  }
  .work-row[aria-expanded="true"] .row-toggle::after {
    transform: rotate(0deg);
  }

  /* Panel animates its real content height (0fr -> 1fr), so open and close
     run the same distance at the same speed — no max-height guesswork.
     visibility flips after the close finishes, which also keeps the
     collapsed text out of the tab order and the accessibility tree. */
  .row-panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 260ms var(--enter-easing),
      visibility 0s linear 260ms;
  }
  li:has(.work-row[aria-expanded="true"]) .row-panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 260ms var(--enter-easing), visibility 0s;
  }
  .row-panel-clip {
    min-height: 0;
    overflow: hidden;
  }
  .row-blurb {
    margin: 0 0 0 calc(3rem + 26px);
    padding: 4px 0 28px;
    max-width: 560px;
    font: 15px/1.55 var(--serif);
    color: var(--ink-soft);
    opacity: 0;
    transition: opacity 160ms ease-out;
  }
  li:has(.work-row[aria-expanded="true"]) .row-blurb {
    opacity: 1;
    transition: opacity 200ms ease-out 60ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-row {
      transition: background-color 160ms ease-out, color 160ms ease-out;
    }
    .work-row:hover {
      background: var(--ink);
      color: var(--paper);
    }
    .work-row:hover .row-num,
    .work-row:hover .row-role,
    .work-row:hover .row-years,
    .work-row:hover .row-toggle {
      color: var(--ink-soft-inverse);
    }
  }

  @media (max-width: 700px) {
    .work-row {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
      padding: 22px 8px;
    }
    .row-role,
    .row-years {
      display: none;
    }
    .row-blurb {
      margin-left: calc(2rem + 26px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-row,
    .row-toggle::before,
    .row-toggle::after,
    .row-panel,
    li:has(.work-row[aria-expanded="true"]) .row-panel,
    .row-blurb,
    li:has(.work-row[aria-expanded="true"]) .row-blurb {
      transition: none;
    }
  }
</style>

<!-- Without JS the rows can't toggle, so show every description. -->
<noscript>
  <style is:inline>
    .row-panel {
      grid-template-rows: 1fr !important;
      visibility: visible !important;
    }
    .row-blurb {
      opacity: 1 !important;
    }
    .row-toggle {
      display: none !important;
    }
  </style>
</noscript>

<script>
  // aria-expanded is the single source of truth; CSS reads it via :has().
  document
    .querySelectorAll<HTMLButtonElement>("[data-work] .work-row")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
      });
    });
</script>
