---
// Selected Work — editorial index of case studies and hobby projects.
// Items invert on hover — title row and description as one block; the
// description stays collapsed until hover/focus (always visible on touch
// devices that can't hover).
import { workEntries } from "../data/work";

const client = workEntries.filter((e) => e.kind === "client");
const hobby = workEntries.filter((e) => e.kind === "hobby");
---

<section class="work" aria-labelledby="work-title">
  <div class="work-head">
    <p class="work-kicker">03 / Selected Work</p>
    <h2 id="work-title">Do you even<br /><em>ship?</em></h2>
    <p class="work-dek">Teams I've worked with, and the things I build.</p>
  </div>

  {
    [
      { label: "Work", items: client },
      { label: "Tinkering with", items: hobby },
    ].map((group) => (
      <div class="work-group">
        <h3 class="work-group-label">{group.label}</h3>
        <div class="work-band" aria-hidden="true" />
        <ol class="work-list">
          {group.items.map((entry, i) => (
            <li>
              <a
                href="#"
                class="work-row"
                aria-label={`${entry.name} — ${entry.role}`}
              >
                <span class="row-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="row-title">{entry.name}</span>
                <span class="row-role">{entry.role}</span>
                <span class="row-years">{entry.years}</span>
                <span class="row-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
              <div class="row-blurb">
                <div class="row-blurb-clip">
                  <p>{entry.blurb}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</section>

<style>
  .work {
    background: var(--paper);
    color: var(--ink);
    padding: 14vh 4vw 12vh;
    font-family: var(--serif);
  }
  .work-head {
    max-width: 1000px;
    margin: 0 auto 9vh;
  }
  .work-kicker {
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin: 0 0 28px;
  }
  .work-head h2 {
    font: clamp(3rem, 8vw, 8rem) / 0.85 var(--serif);
    letter-spacing: -0.07em;
    font-weight: 400;
    margin: 0 0 26px;
  }
  .work-head em {
    font-style: italic;
  }
  .work-dek {
    font: 16px/1.55 var(--serif);
    color: var(--ink-soft);
    max-width: 420px;
    margin: 0;
  }

  .work-group {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
  }
  .work-group + .work-group {
    margin-top: 9vh;
  }
  .work-group-label {
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin: 0 0 6px;
    font-weight: 400;
  }
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .work-list li + li {
    border-top: 1px solid var(--rule);
  }
  .work-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto auto 2rem;
    gap: 18px;
    align-items: baseline;
    padding: 30px 8px 22px;
    color: inherit;
    text-decoration: none;
    position: relative;
    z-index: 2;
  }
  .row-num {
    font: 11px var(--mono);
    color: var(--ink-soft);
  }
  .row-title {
    font: clamp(1.7rem, 3.4vw, 2.9rem) / 1 var(--serif);
    letter-spacing: -0.03em;
  }
  .row-role,
  .row-years {
    font: 11px var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .row-arrow {
    justify-self: end;
    color: var(--accent-ink);
    opacity: 0;
    transform: translate(-6px, 4px);
  }

  /* Each item is one unit with a single engaged state: the whole item —
     title row and description — inverts as one block, and the description
     opens with it. Triggered by hovering anywhere on the item or by keyboard
     focus. The description is a 0fr → 1fr grid track, so it animates its
     real height and all of its spacing lives inside the item (no strip
     between items where hover could drop). Always expanded on devices
     without hover (touch). */
  .row-blurb {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    position: relative;
    z-index: 2;
    transition: grid-template-rows var(--work-dur) var(--work-ease),
      opacity var(--work-dur) var(--work-ease);
  }
  .row-blurb-clip {
    min-height: 0;
    overflow: hidden;
  }
  .row-blurb p {
    margin: 0 0 0 calc(3rem + 26px);
    padding: 0 0 26px;
    font: 14px/21px var(--serif);
    color: var(--ink-soft);
    max-width: 560px;
  }
  .work-group:not([data-band]) li:hover .row-blurb,
  .work-group:not([data-band]) li:focus-within .row-blurb,
  .work-group[data-band] li.is-engaged .row-blurb {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  @media (hover: none) {
    .row-blurb {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  /* One curve and one duration for everything that moves here, so the
     description opening, the previous one closing and the band landing all
     arrive together. Strong ease-out: no overshoot, nothing to bounce. */
  .work {
    --work-ease: cubic-bezier(0.23, 1, 0.32, 1);
    --work-dur: 220ms;
  }
  .work-row,
  .row-num,
  .row-role,
  .row-years,
  .row-blurb p {
    transition: color var(--work-dur) var(--work-ease);
  }
  .row-arrow {
    transition: opacity var(--work-dur) var(--work-ease),
      transform var(--work-dur) var(--work-ease);
  }

  /* Fallback path (JS off): each item inverts itself on hover/focus. */
  @media (hover: hover) and (pointer: fine) {
    .work-group:not([data-band]) .work-list li {
      transition: background-color var(--work-dur) var(--work-ease);
    }
    .work-group:not([data-band]) .work-list li:hover,
    .work-group:not([data-band]) .work-list li:focus-within {
      background: var(--ink);
    }
    .work-group:not([data-band]) .work-list li:hover .work-row,
    .work-group:not([data-band]) .work-list li:focus-within .work-row,
    .work-group:not([data-band]) .work-list li:hover .row-blurb p,
    .work-group:not([data-band]) .work-list li:focus-within .row-blurb p {
      color: var(--paper);
    }
    .work-group:not([data-band]) .work-list li:hover .row-num,
    .work-group:not([data-band]) .work-list li:hover .row-role,
    .work-group:not([data-band]) .work-list li:hover .row-years,
    .work-group:not([data-band]) .work-list li:focus-within .row-num,
    .work-group:not([data-band]) .work-list li:focus-within .row-role,
    .work-group:not([data-band]) .work-list li:focus-within .row-years {
      color: #b9b3aa;
    }
    .work-group:not([data-band]) .work-list li:hover .row-arrow,
    .work-group:not([data-band]) .work-list li:focus-within .row-arrow {
      opacity: 1;
      transform: none;
    }
  }

  /* Banded path (JS on): one shared band paints the inversion and slides
     between items, sitting above static content but below the item's text.
     Its height is a real height, not a scaled 1px strip: at fractional zoom
     or pixel ratios the strip gets snapped to a whole device pixel before
     scaling and the band comes out visibly short. */
  .work-band {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0;
    background: var(--ink);
    opacity: 0;
    z-index: 1;
    pointer-events: none;
    transition: transform var(--work-dur) var(--work-ease),
      height var(--work-dur) var(--work-ease), opacity 160ms ease-out;
  }
  .work-band.is-on {
    opacity: 1;
  }
  .work-group[data-band] li.is-engaged .work-row,
  .work-group[data-band] li.is-engaged .row-blurb p {
    color: var(--paper);
  }
  .work-group[data-band] li.is-engaged .row-num,
  .work-group[data-band] li.is-engaged .row-role,
  .work-group[data-band] li.is-engaged .row-years {
    color: #b9b3aa;
  }
  .work-group[data-band] li.is-engaged .row-arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 700px) {
    .work-row {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
    }
    .row-role,
    .row-years {
      display: none;
    }
    .row-blurb p {
      margin-left: calc(2rem + 18px);
    }
  }
  /* Reduced motion: keep the color and opacity changes, drop the movement. */
  @media (prefers-reduced-motion: reduce) {
    .row-blurb {
      transition: opacity var(--work-dur) var(--work-ease);
    }
    .work-band {
      transition: opacity 160ms ease-out;
    }
    .row-arrow {
      transition: opacity var(--work-dur) var(--work-ease);
    }
  }
</style>

<script>
  // Traveling inversion band: one shared black block per list that slides
  // between engaged items. Its target is the item's resting box — where the
  // item will sit once every other description has closed and its own has
  // opened — so the band goes straight there on one CSS transition instead
  // of chasing the layout while it shifts.
  const FINE_HOVER = "(hover: hover) and (pointer: fine)";

  function initWorkBands() {
    if (!matchMedia(FINE_HOVER).matches) return;

    document.querySelectorAll<HTMLElement>(".work-group").forEach((group) => {
      const band = group.querySelector<HTMLElement>(".work-band");
      const list = group.querySelector<HTMLElement>(".work-list");
      if (!band || !list) return;
      group.setAttribute("data-band", "");

      const items = [...list.querySelectorAll<HTMLElement>(":scope > li")];
      let engagedLi: HTMLElement | null = null;
      let exitTimer = 0;

      // Current (possibly mid-transition) and fully open description heights.
      const blurbHeight = (li: HTMLElement) =>
        li.querySelector(".row-blurb")?.getBoundingClientRect().height ?? 0;
      const openHeight = (li: HTMLElement) =>
        li.querySelector(".row-blurb-clip")?.scrollHeight ?? 0;

      function restingBox(li: HTMLElement, open: boolean) {
        const r = li.getBoundingClientRect();
        let y = r.top - group.getBoundingClientRect().top;
        for (const other of items) {
          if (other === li) break;
          y -= blurbHeight(other);
        }
        const h = r.height - blurbHeight(li) + (open ? openHeight(li) : 0);
        return { y, h };
      }

      function place(box: { y: number; h: number }, animate: boolean) {
        if (!animate) band!.style.transition = "none";
        band!.style.transform = `translateY(${box.y}px)`;
        band!.style.height = `${box.h}px`;
        if (!animate) {
          void band!.offsetHeight;
          band!.style.transition = "";
        }
      }

      function engage(li: HTMLElement) {
        clearTimeout(exitTimer);
        if (li === engagedLi) return;
        // Coming from nothing: start on the title row and fade in while
        // growing over the description, rather than flying in from wherever
        // the band was last.
        if (!engagedLi && Number(getComputedStyle(band!).opacity) < 0.05)
          place(restingBox(li, false), false);
        engagedLi?.classList.remove("is-engaged");
        li.classList.add("is-engaged");
        engagedLi = li;
        band!.classList.add("is-on");
        place(restingBox(li, true), true);
      }

      function scheduleExit() {
        clearTimeout(exitTimer);
        exitTimer = setTimeout(() => {
          if (!engagedLi) return;
          const li = engagedLi;
          li.classList.remove("is-engaged");
          engagedLi = null;
          band!.classList.remove("is-on");
          place(restingBox(li, false), true); // shrink back onto the title row
        }, 180);
      }

      items.forEach((li) => {
        li.addEventListener("pointerenter", () => engage(li));
      });
      list.addEventListener("pointerleave", scheduleExit);
      list.addEventListener("focusin", (e) => {
        if (!(e.target instanceof Element)) return;
        const li = e.target.closest("li");
        if (li && list.contains(li)) engage(li);
      });
      list.addEventListener("focusout", (e) => {
        const focusEvent = e as FocusEvent;
        if (
          !focusEvent.relatedTarget ||
          !(focusEvent.relatedTarget instanceof Node) ||
          !list.contains(focusEvent.relatedTarget)
        ) {
          scheduleExit();
        }
      });

      // Text reflows on resize; re-seat the band without animating.
      addEventListener("resize", () => {
        if (engagedLi) place(restingBox(engagedLi, true), false);
      });
    });
  }

  initWorkBands();
</script>
